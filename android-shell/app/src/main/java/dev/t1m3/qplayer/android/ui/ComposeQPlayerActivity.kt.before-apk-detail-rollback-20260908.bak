            staggeredEntry = false,
            emptyContent = { EmptyState("播放队列为空", "从歌曲列表选择一首开始播放") { } }
        )
    }
}

@Composable
private fun PlaylistScreen(state: PlayerUiState, controller: PlayerController) {
