private fun previewPlayerState(): PlayerUiState {
    val playlists = listOf("每日推荐", "私人雷达").mapIndexed { index, title ->
        NeteasePlaylist().apply {
            id = index + 1L
            name = title
            trackCount = 24 + index * 8
        }
    }
    val songs = (1..3).map { index ->
        NeteaseSong().apply {
            id = index.toLong()
            name = "示例歌曲 $index"
            artist = "示例歌手"
            album = "示例专辑"
        }
    }
    return PlayerUiState(
        title = "示例歌曲",
        artist = "示例歌手",
        album = "示例专辑",
